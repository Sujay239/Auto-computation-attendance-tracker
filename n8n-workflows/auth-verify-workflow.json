    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  e.id,\n  e.first_name AS \"firstName\",\n  e.last_name AS \"lastName\",\n  e.email,\n  e.phone,\n  e.avatar_url AS \"avatarUrl\",\n  e.designation,\n  e.joining_date::TEXT AS \"joiningDate\",\n  e.employment_type AS \"employmentType\",\n  e.work_location AS \"workLocation\",\n  e.role,\n  e.is_active AS \"isActive\"\nFROM employees e\nWHERE (e.id = '{{ $json.userId }}' OR LOWER(e.email) = LOWER('{{ $json.userId }}'))\n  AND e.is_active = TRUE\nLIMIT 1;",
        "options": {}
      },
      "id": "aver-0006-4000-8000-000000000006",
      "name": "Postgres - Fetch Active Employee Record",
