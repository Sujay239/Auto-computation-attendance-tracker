        "jwtAuth": {
          "id": "XMvqVX3BtA2Ba0J0",
          "name": "JWT Auth account"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const inputData = $input.first().json || {};\n\nif (inputData.error) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid or expired token. Please log in again.\"\n    }\n  }];\n}\n\nconst claims = inputData.payload || inputData;\n\nif (!claims || !claims.sub) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid authentication token structure.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    userId: String(claims.sub).trim(),\n    role: String(claims.role || 'EMPLOYEE').toUpperCase().trim(),\n    email: claims.email || null\n  }\n}];"
      },
      "id": "aver-0004-4000-8000-000000000004",
      "name": "Code - Parse Claims",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
