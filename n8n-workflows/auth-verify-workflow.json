    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst emp = (items.length > 0 && items[0].json) ? items[0].json : null;\n\nif (!emp || !emp.id) {\n  return [{\n    json: {\n      success: false,\n      statusCode: 401,\n      error: \"User account is inactive or no longer exists.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    valid: true,\n    role: emp.role || 'EMPLOYEE',\n    employee: emp\n  }\n}];"
      },
