      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst updatedIds = [];\n\nfor (const item of items) {\n  if (item.json && item.json.id) {\n    updatedIds.push(item.json.id);\n  }\n}\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    message: `Marked ${updatedIds.length} notification(s) as read.`,\n    updatedIds: updatedIds\n  }\n}];"
      },
