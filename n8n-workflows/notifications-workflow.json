        1700,
        60
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": {
          "id": "postgres_credentials_placeholder",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst list = [];\n\nfor (const item of items) {\n  if (item.json && item.json.id) {\n    list.push(item.json);\n  }\n}\n\nconst unreadCount = list.filter(n => !n.read).length;\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    notifications: list,\n    unreadCount: unreadCount,\n    totalCount: list.length\n  }\n}];"
      },
      "id": "notif1a2-0008-4000-8000-000000000008",
      "name": "Code - Format Notification List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        60
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE notifications\nSET is_read = TRUE\nWHERE employee_id = '{{ $json.callerId }}'\n  AND (\n    '{{ $json.notificationId }}' = 'ALL'\n    OR '{{ $json.notificationId }}' = ''\n    OR id = '{{ $json.notificationId }}'\n  )\nRETURNING id, is_read;",
        "options": {}
      },
