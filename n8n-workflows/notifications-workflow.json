    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  id,\n  employee_id AS \"employeeId\",\n  category,\n  title,\n  message,\n  action_route AS \"actionRoute\",\n  priority,\n  is_read AS \"read\",\n  created_at::TEXT AS \"createdAt\"\nFROM notifications\nWHERE employee_id = '{{ $json.callerId }}'\nORDER BY created_at DESC\nLIMIT 100;",
        "options": {}
      },
      "id": "notif1a2-0007-4000-8000-000000000007",
