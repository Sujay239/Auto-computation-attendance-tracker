      "id": "4ad559f1-3218-4be3-af97-5c10a3312378",
      "name": "JWT",
      "onError": "continueRegularOutput",
      "credentials": {
        "jwtAuth": {
          "id": "XMvqVX3BtA2Ba0J0",
          "name": "JWT Auth account"
        }
      }
    },
    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const inputData = $input.first().json || {};\n\nif (inputData.error) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid or expired authentication token. Outsiders are not permitted.\"\n    }\n  }];\n}\n\nconst claims = inputData.payload || inputData;\n\nif (!claims || !claims.sub) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid or malformed authentication token. Please log in again.\"\n    }\n  }];\n}\n\nconst callerId = String(claims.sub).trim();\nconst callerRole = String(claims.role || 'EMPLOYEE').toUpperCase().trim();\n\nconst webhookNode = $('Webhook - POST /notifications').first().json || {};\nconst body = webhookNode.body || {};\n\nlet action = String(body.action || 'LIST').toUpperCase().trim();\nif (body.markAll === true) {\n  action = 'MARK_ALL_READ';\n}\n\nconst notificationId = String(body.notificationId || (action === 'MARK_ALL_READ' ? 'ALL' : '')).trim();\n\nreturn [{\n  json: {\n    valid: true,\n    action: action,\n    callerId: callerId,\n    callerRole: callerRole,\n    notificationId: notificationId\n  }\n}];"
      },
      "id": "notif1a2-0004-4000-8000-000000000004",
