    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst holidays = [];\n\nfor (const item of items) {\n  if (item.json && item.json.id) {\n    holidays.push(item.json);\n  }\n}\n\nconst today = new Date().toISOString().split('T')[0];\nconst upcomingHolidays = holidays.filter(h => h.date >= today);\nconst next = upcomingHolidays[0] || null;\n\nlet nextHolidayInfo = {\n  holiday: null,\n  daysRemaining: 0,\n  isToday: false\n};\n\nif (next) {\n  const tDate = new Date(today);\n  const hDate = new Date(next.date);\n  const diffTime = hDate.getTime() - tDate.getTime();\n  const daysRemaining = Math.max(0, Math.ceil(diffTime / (1000 * 60 * 60 * 24)));\n  nextHolidayInfo = {\n    holiday: next,\n    daysRemaining: daysRemaining,\n    isToday: next.date === today\n  };\n}\n\nreturn [{\n  json: {\n    success: true,\n    statusCode: 200,\n    holidays: holidays,\n    upcomingHolidays: upcomingHolidays,\n    nextHoliday: nextHolidayInfo,\n    totalCount: holidays.length\n  }\n}];"
      },
