    {
      "parameters": {
        "language": "javaScript",
        "jsCode": "const inputData = $input.first().json || {};\n\nif (inputData.error) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid or expired authentication token. Outsiders are not permitted.\"\n    }\n  }];\n}\n\nconst claims = inputData.payload || inputData;\n\nif (!claims || !claims.sub) {\n  return [{\n    json: {\n      valid: false,\n      statusCode: 401,\n      error: \"Invalid or malformed authentication token. Please log in again.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    callerId: String(claims.sub).trim(),\n    callerRole: String(claims.role || 'EMPLOYEE').toUpperCase().trim()\n  }\n}];"
      },
