        "operation": "executeQuery",
        "query": "SELECT \n  id,\n  name,\n  date::TEXT AS date,\n  day,\n  type,\n  description,\n  is_office_closed AS \"isOfficeClosed\"\nFROM holidays\nORDER BY date ASC;",
        "options": {}
      },
      "id": "hol1a2b3-0006-4000-8000-000000000006",
      "name": "Postgres - Fetch Holidays",
      "type": "n8n-nodes-base.postgres",
